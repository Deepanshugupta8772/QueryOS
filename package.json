{
  "name": "QueryOS",
  "version": "1.0.0",
  "description": "SAP Order-to-Cash graph and query system",
  "engines": {
    "node": "20.x"
  },
  "main": "backend/src/server.js",
  "scripts": {
    "seed": "node backend/src/db/seed.js",
    "start": "node backend/src/server.js",
    "dev:server": "node backend/src/server.js",
    "dev:client": "vite --config frontend/vite.config.mjs",
    "build": "npm run build:client",
    "build:client": "vite build --config frontend/vite.config.mjs",
    "preview:client": "vite preview --config frontend/vite.config.mjs"
  },
  "keywords": [
    "sap",
    "o2c",
    "graph",
    "sqlite",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "axios": "^1.13.6",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-force-graph": "^1.48.2",
    "sqlite3": "^5.1.7",
    "vite": "^5.4.19"
  }
}
